# Portify Backend Environment Variables
PORT=5000
NODE_ENV=development

# MongoDB Cloud (Atlas) Connection String
# Replace <username>, <password>, and <cluster-url> with your real MongoDB Atlas credentials
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/portify?retryWrites=true&w=majority

# Client URL (Frontend)
CLIENT_URL=http://localhost:5173
